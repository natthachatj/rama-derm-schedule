SITE_URL=https://YOUR-SITE.netlify.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
ADMIN_EMAIL=
# Optional email-code login (server-side secrets, never VITE_ variables)
RESEND_API_KEY=
# A sender on your verified Resend domain, e.g. RAMA DERM Sx <schedule@example.org>
EMAIL_FROM=

# Clinical owner is deliberately independent of ADMIN_EMAIL.
# Must be the verified email of the owner's Google account, never a password/email-code account.
CLINICAL_OWNER_EMAIL=natthachat.j.md@gmail.com
# Optional additional Google subject pin, visible from your Google account identity.
CLINICAL_OWNER_GOOGLE_SUB=
# Uses existing GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET and SESSION_SECRET.
# Add this redirect URI to the same Google OAuth web client:
# https://rama-derm-schedule.netlify.app/auth/clinical/google/callback
